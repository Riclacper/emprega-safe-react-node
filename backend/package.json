{
  "name": "empregasafe-backend",
  "version": "2.1.0",
  "description": "API do EmpregaSafe 2.0 com Express, MongoDB, JWT e IA opcional.",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "seed": "node src/seed.js",
    "seed:analyses": "node scripts/seed-professional-analyses.js",
    "seed:analyses:hybrid": "node scripts/seed-hybrid-analyses.js",
    "cleanup:duplicate-reports": "node scripts/cleanup-duplicate-reports.js",
    "backfill:analysis-fingerprints": "node scripts/backfill-analysis-fingerprints.js",
    "test": "npm run test:unit && npm run test:security && npm run test:ai",
    "test:unit": "node --test tests/unit/*.test.js",
    "test:security": "node --test tests/security/*.test.js",
    "test:ai": "node scripts/evaluate-ai.js",
    "test:ai:live": "node scripts/evaluate-ai.js --live-ai"
  },
  "engines": {
    "node": ">=20.x"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.5",
    "dotenv": "^17.4.1",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.1",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^8.16.0",
    "morgan": "^1.10.0",
    "nodemailer": "^8.0.7",
    "openai": "^4.104.0"
  },
  "devDependencies": {
    "nodemon": "^3.1.10",
    "supertest": "^7.2.2"
  }
}
